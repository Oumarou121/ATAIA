
# Copiez ce fichier en « .env » (même dossier) puis renseignez vos valeurs.
# Ces paramètres ne sont PAS secrets. Le mot de passe SMTP, lui, se règle à part :
#   firebase functions:secrets:set SMTP_PASS

# Serveur SMTP du compte qui envoie les mails (ex. smtp.gmail.com, ou celui de votre hébergeur de messagerie)
SMTP_HOST=smtp.example.com
# 465 (TLS direct) ou 587 (STARTTLS)
SMTP_PORT=465
# Identifiant de la boîte d'envoi (souvent l'adresse e-mail complète)
SMTP_USER=contact@votre-domaine.com
# Adresse qui REÇOIT les messages du formulaire
MAIL_TO=contact@votre-domaine.com
# Adresse expéditrice (facultatif ; par défaut SMTP_USER). Elle doit appartenir au compte SMTP.
MAIL_FROM=
# Sites autorisés à appeler la fonction, séparés par des virgules (facultatif mais conseillé)
ALLOWED_ORIGINS=https://ataiau.web.app,https://ataiau.firebaseapp.com
