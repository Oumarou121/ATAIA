{
  "hosting": {
    "public": "out",
    "site": "ataiau",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "function": { "functionId": "contact", "region": "europe-west1" }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log", ".env.example", "test", "**/*.local"]
    }
  ]
}
